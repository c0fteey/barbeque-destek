# Normalde gerekmez: VDS'te ajan bu değerleri bbq-deploy panelinden (Destek sayfası) verir.
# Botu elle çalıştırırken bu dosyayı .env olarak kopyala; "cargo run" ya da "npm start" .env'i okur.
MICUP_TOKEN=
# Guard kayıtlarının yazılacağı kanalın ID'si (isteğe bağlı).
LOG_CHANNEL_ID=
# İzinli alan adları, virgülle. Davet linkleri her zaman yasak.
ALLOWED_DOMAINS=micup.gg
